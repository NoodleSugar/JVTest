{
	"name": "Jv Dev",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"fill-labs.dependi",
				"vadimcn.vscode-lldb",
				"tamasfe.even-better-toml",
				"mistralai.mistral-vibe-code"
			]
		}
	},
	"mounts": [
		{
			"type": "volume",
			"source": "cargo-registry",
			"target": "/home/devuser/.cargo/registry"
		}
	],
	"remoteUser": "devuser",
	"initializeCommand": "(cd ${localWorkspaceFolder}/dev-containers && ./build.sh debian && ./build.sh rust)",
	"postCreateCommand": "git lfs install"
}