{
	"name": "Jv Dev",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"fill-labs.dependi",
				"vadimcn.vscode-lldb",
				"tamasfe.even-better-toml"
			]
		}
	},
	"remoteEnv": {
		"XDG_RUNTIME_DIR": "/tmp",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"PULSE_SERVER": "/tmp/pulse.socket"
	},
	"runArgs": [],
	"mounts": [
		{
			"source": "${localEnv:HOME}/.cargo",
			"target": "/home/devuser/.cargo",
			"type": "bind"
		},
		{
			"source": "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}",
			"target": "/tmp/${localEnv:WAYLAND_DISPLAY}",
			"type": "bind"
		},
		{
			"source": "${localEnv:XDG_RUNTIME_DIR}/pipewire-0",
			"target": "/tmp/pipewire-0",
			"type": "bind"
		},
		{
			"source": "${localEnv:XDG_RUNTIME_DIR}/pulse/native",
			"target": "/tmp/pulse.socket",
			"type": "bind"
		}
	],
	"remoteUser": "devuser"
}